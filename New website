  <style>
/* ============================================================
   Student Club Hub - Paper theme (styles/theme.css)
   Loaded LAST so it re-skins main/pages/components without
   touching their layout. White graph-paper page, red as the main
   accent, yellow sticky-note tags. Boxes are square-edged cards
   with a solid ink border and a hard offset shadow, like cut-out
   paper on a bulletin board. Delete this file's <link> to revert.
   ============================================================ */

/* ---- Tokens: light (default) ---- */
:root[data-theme="light"], :root:not([data-theme]) {
  --ground: #ffffff;
  --grid-line: rgba(26, 26, 26, 0.045);
  --box-ink: #1a1a1a;              /* box borders + hard shadows */

  --navy: #1a1a1a;
  --brand: #d62828;                /* red - buttons, links, focus */
  --brand-dark: #a91d1d;
  --brand-light: #f4a3a3;
  --brand-50: #fdecec;
  --note: #ffd84d;                 /* yellow sticky note */
  --note-soft: #fff4c2;
  --grad-brand: #d62828;
  --grad-brand-strong: #d62828;
  --accent: #d62828;
  --accent-dark: #a91d1d;
  --join: #d62828;
  --join-dark: #a91d1d;

  --ink: #1a1a1a;
  --muted: #555555;
  --faint: #8a8a8a;
  --line: #1a1a1a;
  --bg: var(--ground);
  --card: #ffffff;
  --surface: #faf8f3;
  --surface-2: #f1eee6;
  --input-bg: #ffffff;
  --header-color: #ffffff;
  --header-bg: #ffffff;
  --modal-bg: #ffffff;

  --shadow-sm: 4px 4px 0 var(--box-ink);
  --shadow-md: 6px 6px 0 var(--box-ink);
  --shadow-lg: 8px 8px 0 var(--box-ink);
}

/* ---- Tokens: dark (same palette on charcoal) ---- */
:root[data-theme="dark"] {
  --ground: #161616;
  --grid-line: rgba(255, 255, 255, 0.04);
  --box-ink: #000000;

  --navy: #161616;
  --brand: #ef4444;
  --brand-dark: #ff7a7a;
  --brand-light: #7f1d1d;
  --brand-50: rgba(239, 68, 68, 0.14);
  --note: #ffd84d;
  --note-soft: rgba(255, 216, 77, 0.16);
  --grad-brand: #e03131;
  --grad-brand-strong: #e03131;
  --accent: #ef4444;
  --accent-dark: #ff7a7a;
  --join: #e03131;
  --join-dark: #c92a2a;

  --ink: #f2efe8;
  --muted: #b3aea4;
  --faint: #7c776e;
  --line: #3a3835;
  --bg: var(--ground);
  --card: #222120;
  --surface: #1c1b1a;
  --surface-2: #2b2a28;
  --input-bg: #1c1b1a;
  --header-color: #161616;
  --header-bg: #161616;
  --modal-bg: #222120;

  --shadow-sm: 4px 4px 0 var(--box-ink);
  --shadow-md: 6px 6px 0 var(--box-ink);
  --shadow-lg: 8px 8px 0 var(--box-ink);
}

/* ---- Shared tokens ---- */
:root {
  --font-body: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  --font-head: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  --r-sm: 3px;
  --r: 4px;
  --r-lg: 6px;
  --r-pill: 4px;                   /* pills become small square tags too */
  --edge: 1.5px solid var(--line);
}

/* ---- Ground: white graph paper ---- */
body { background: var(--ground); }
body::before {
  content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
  background:
    linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 28px 28px,
    linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 28px 28px;
}
main, .app-view { position: relative; }

/* ---- Type ---- */
h1, h2, h3, h4, .brand, .page-head h1 { font-weight: 800; letter-spacing: -0.02em; color: var(--ink); }
.hero h1 {
  color: var(--ink); text-shadow: none;
  font-size: clamp(2.2rem, 5.2vw, 3.6rem); font-weight: 900; line-height: 1.04;
