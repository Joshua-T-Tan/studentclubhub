/* ---- Boxes: square edges, ink border, hard offset shadow ---- */
.card, .tcard, .stat, .step, .spot-card, .poly-front, .prow, .modal, .nav-menu {
  background: var(--card);
  border: var(--edge);
  border-radius: var(--r);
  box-shadow: var(--shadow-sm);
