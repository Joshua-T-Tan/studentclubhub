.tab-row { display: flex; gap: 6px; background: #f1f5f9; padding: 4px; border-radius: var(--r); margin-bottom: 18px; }
.tab-row button { flex: 1; padding: 9px; border-radius: 10px; font-weight: 700; color: var(--muted); }
.tab-row button.active { background: #fff; color: var(--ink); box-shadow: var(--shadow-sm); }
.auth-error { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c;
  font-size: 0.85rem; border-radius: var(--r-sm); padding: 9px 12px; margin-bottom: 12px; }
