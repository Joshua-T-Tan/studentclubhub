  var d = Math.floor(h / 24); if (d < 7) return d + ' day' + (d === 1 ? '' : 's') + ' ago';
  var w = Math.floor(d / 7); if (w < 5) return w + ' week' + (w === 1 ? '' : 's') + ' ago';
