/* ============================================================
   Student Club Hub - components.css
   Isolated, reusable UI widgets: modal/overlay shells, the auth
   modal, lightbox, confirm dialog, toast, and the share modal.
   Loaded AFTER main.css. Palette tokens live in main.css.
