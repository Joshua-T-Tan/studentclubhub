function applyTheme(mode) {
  mode = (mode === 'dark') ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', mode);
  try { localStorage.setItem(LS.theme, mode); } catch (e) {}
}
function toggleTheme() {
