.card { transition: transform .12s ease, box-shadow .12s ease; }
.card:hover { transform: translate(-2px, -2px); box-shadow: var(--shadow-md); }
.modal { box-shadow: var(--shadow-lg); }

.site-header { background: var(--header-bg); border-bottom: 2px solid var(--line); }
.brand { color: var(--ink); }
.site-header .nav-trigger { color: var(--ink); }
.site-header .nav-trigger:hover, .site-header .nav-trigger.active { background: var(--note-soft); color: var(--ink); }
.site-header .nav-toggle { color: var(--ink); }
.site-header .btn.header-outline { color: var(--ink); border: var(--edge); background: var(--card); }
.site-header .btn.header-outline:hover { background: var(--note); border-color: var(--line); }
.site-header .user-chip .name { color: var(--ink); }
.site-header .logout-btn { color: var(--ink); background: var(--card); border: var(--edge); }
.site-footer { background: var(--ground); border-top: 2px solid var(--line); }

/* ---- Modals: dark scrim, square paper card ---- */
.overlay { background: rgba(20, 20, 20, 0.5); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }

/* ---- Controls ---- */
.btn { border-radius: var(--r); }
.btn.primary, .btn.cta, .btn.join, .site-header .btn.header-cta {
  background: var(--brand); color: #fff; border: var(--edge);
  box-shadow: 3px 3px 0 var(--box-ink);
}
.btn.primary:hover, .btn.cta:hover, .btn.join:hover, .site-header .btn.header-cta:hover {
  background: var(--brand-dark); filter: none;
  transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--box-ink);
}
.btn.primary:active, .btn.cta:active, .btn.join:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--box-ink); }
[data-theme] .btn.ghost, .btn.glass, .btn.blue {
  background: var(--card); color: var(--ink); border: var(--edge);
}
